---
import { nl, filled } from '../lib/text';
import site from '@site/site';
import { getCollection } from 'astro:content';
const { brand, business, contact, nav } = site;
const pages = (await getCollection('pages')).sort((a, b) => a.data.order - b.data.order);
const col = (g: string) => pages.filter((p) => p.data.group === g);
const year = new Date().getFullYear();
---
<footer class="ftr">
  <div class="wrap">
    <div class="ftr__grid">
      <div>
        <p class="ftr__brand">{brand.name}</p>
        <p class="ftr__tel"><a href={contact.telHref}>{contact.phoneDisplay}</a></p>
        {filled(contact.hours) && <p>{contact.hours}</p>}
        <p>시공 지역 {business.areaServedLabel}</p>
      </div>
      <nav aria-label="안내"><h4>안내</h4><ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul></nav>
      <nav aria-label="설치 장소별"><h4>설치 장소별</h4><ul>{col('space').map((p) => <li><a href={`/${p.id}`}>{p.data.heading ?? p.data.title}</a></li>)}</ul></nav>
      <nav aria-label="이용 대상 · 정보"><h4>이용 대상 · 정보</h4><ul>{[...col('target'), ...col('service'), ...col('info')].map((p) => <li><a href={`/${p.id}`}>{p.data.heading ?? p.data.title}</a></li>)}</ul></nav>
    </div>
    <div class="ftr__biz">
      <span>상호 {business.legalName}</span>
      {filled(business.owner) && <span>대표 {business.owner}</span>}
      {filled(business.registrationNo) && <span>사업자등록번호 {business.registrationNo}</span>}
      {filled(business.address.street) && <span>주소 {business.address.city} {business.address.street}</span>}
    </div>
    <p class="ftr__copy">© {year} {brand.name}</p>
  </div>
</footer>
<style>
  /* 아래쪽 여백은 화면 하단 상담 바 자리. body가 아니라 푸터에 둬야 여백까지 푸터 색이 이어진다 */
  .ftr { background: var(--dark); color: rgba(255,255,255,.62); padding: 64px 0 calc(36px + var(--dock) + env(safe-area-inset-bottom)); font-size: 14px; border-top: 1px solid var(--dark-2); }
  .ftr__grid { display: grid; grid-template-columns: 1.3fr .8fr 1fr 1fr; gap: 40px; }
  .ftr__brand { color: #fff; font-weight: 800; font-size: 18px; margin-bottom: 14px; }
  .ftr__tel a { color: #fff; font-size: 22px; font-weight: 700; }
  .ftr__tel { margin-bottom: 8px; }
  .ftr h4 { color: rgba(255,255,255,.4); font-size: 12px; font-weight: 600; letter-spacing: .06em; margin-bottom: 14px; }
  .ftr li { margin-bottom: 8px; }
  .ftr a:hover { color: #fff; }
  .ftr__biz { margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--dark-2); display: flex; flex-wrap: wrap; gap: 6px 20px; font-size: 13px; }
  .ftr__copy { margin-top: 10px; font-size: 12px; color: rgba(255,255,255,.35); }
  @media (max-width: 860px) { .ftr__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .ftr__grid { grid-template-columns: 1fr; } }
</style>
