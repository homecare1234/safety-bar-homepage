---
import site from '@site/site';
import Icon from './Icon.astro';
const { brand, nav, contact } = site;
---
<header class="hdr">
  <div class="wrap hdr__in">
    <a href="/" class="logo" aria-label={`${brand.name} 처음으로`}>
      {brand.logoImage ? <img src={brand.logoImage} alt={brand.name} width="150" height="36" /> : <><span class="logo__bar" aria-hidden="true"></span>{brand.name}</>}
    </a>
    <nav class="nav" aria-label="주요 메뉴">{nav.map((n) => <a href={n.href}>{n.label}</a>)}</nav>
    <a class="btn btn--blue hdr__cta" href={contact.telHref}><Icon name="phone" /><span class="hdr__num">{contact.phoneDisplay}</span><span class="hdr__short">전화</span></a>
  </div>
</header>
<style>
  .hdr { position: sticky; top: 0; z-index: 50; background: rgba(255,255,255,.96); border-bottom: 1px solid var(--line); }
  .hdr__in { display: flex; align-items: center; gap: 32px; height: 68px; }
  .logo { display: inline-flex; align-items: center; gap: 9px; font-weight: 800; font-size: 19px; letter-spacing: -0.03em; }
  .logo__bar { width: 6px; height: 22px; border-radius: 2px; background: var(--blue); }
  .nav { display: flex; gap: 28px; margin-left: auto; }
  .nav a { font-size: 15px; font-weight: 500; color: var(--ink-2); }
  .nav a:hover { color: var(--ink); }
  .hdr__cta { min-height: 42px; padding: 0 16px; font-size: 15px; }
  .hdr__short { display: none; }
  @media (max-width: 960px) { .nav { display: none; } .hdr__cta { margin-left: auto; } }
  @media (max-width: 720px) { .hdr__in { height: 58px; } .hdr__num { display: none; } .hdr__short { display: inline; } .hdr__cta { min-height: 38px; padding: 0 14px; } }
</style>
