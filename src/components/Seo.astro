---
// 모든 페이지 <head>. 네이버·구글이 읽는 것은 전부 여기서 나간다.
import site from '@site/site';
interface Props {
  title: string; description: string; keywords?: string[]; path: string;
  image?: string | null; type?: 'website' | 'article'; jsonLd?: object[];
}
const { title, description, keywords = site.keywords, path, image, type = 'website', jsonLd = [] } = Astro.props;
const canonical = new URL(path, site.url).href;
// 기본 공유 이미지는 사이트마다 site.ts의 ogImage. 세부 페이지는 자기 대표 사진을 쓴다
const ogImage = new URL(image ?? site.ogImage, site.url).href;
const { business, contact, brand } = site;
const theme = (site as { theme?: string }).theme; // 디자인 묶음 (Base.astro와 같은 값)

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': new URL('/#business', site.url).href,
  name: brand.name,
  legalName: business.legalName,
  description: site.description,
  url: site.url,
  telephone: `+82-${contact.phoneDigits.replace(/^0/, '').replace(/(\d{2})(\d{4})(\d{4})/, '$1-$2-$3')}`,
  image: ogImage,
  // 주소를 넣지 않는 업체는 시·도만 적힌 주소도 내보내지 않는다 (확인되지 않은 소재지를 알리지 않도록)
  ...(business.address.street ? { address: {
    '@type': 'PostalAddress',
    streetAddress: business.address.street,
    addressLocality: business.address.city,
    addressRegion: business.address.region,
    postalCode: business.address.postalCode || undefined,
    addressCountry: business.address.country,
  } } : {}),
  areaServed: business.areaServed.map((name) => ({ '@type': 'AdministrativeArea', name })),
  founder: business.owner || undefined,
  contactPoint: [{ '@type': 'ContactPoint', telephone: contact.phoneDisplay, contactType: 'customer service', availableLanguage: 'Korean' }],
  ...(business.geo ? { geo: { '@type': 'GeoCoordinates', latitude: business.geo.lat, longitude: business.geo.lng } } : {}),
};
const website = {
  '@context': 'https://schema.org', '@type': 'WebSite', name: site.title, url: site.url, inLanguage: 'ko',
  publisher: { '@id': localBusiness['@id'] },
};
const all = [localBusiness, website, ...jsonLd];
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="keywords" content={keywords.join(', ')} />
{site.launched
  ? <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
  : <meta name="robots" content="noindex, nofollow" />}
<link rel="canonical" href={canonical} />
<meta name="author" content={brand.name} />
{site.verification.naver && <meta name="naver-site-verification" content={site.verification.naver} />}
{site.verification.google && <meta name="google-site-verification" content={site.verification.google} />}
{site.verification.bing && <meta name="msvalidate.01" content={site.verification.bing} />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={brand.name} />
<meta property="og:locale" content="ko_KR" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- 아이콘: public/favicon/ (파비콘 생성기 결과물). 루트의 favicon.ico·apple-touch-icon.png는 기본 경로로 찾는 봇·기기용 사본
     theme이 있는 사이트(반듯한 홈케어 등)는 public/themes/<theme>/ 의 마크를 쓴다 (scripts/make-favicon.mjs로 생성, 빌드 때 루트 favicon.ico도 바꿔 끼움) -->
{theme ? (
  <>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href={`/themes/${theme}/favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`/themes/${theme}/favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="96x96" href={`/themes/${theme}/favicon-96x96.png`} />
    <link rel="icon" type="image/png" sizes="192x192" href={`/themes/${theme}/icon-192.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href={`/themes/${theme}/manifest.json`} />
  </>
) : (
  <>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon/android-icon-192x192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/favicon/manifest.json" />
    <meta name="msapplication-TileColor" content="#2c94fa" />
    <meta name="msapplication-TileImage" content="/favicon/ms-icon-144x144.png" />
    <meta name="msapplication-config" content="/favicon/browserconfig.xml" />
  </>
)}
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
<meta name="theme-color" content={theme === 'warm' ? '#2f5d50' : '#42a1f5'} />
<meta name="format-detection" content="telephone=yes" />

<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />

{all.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
